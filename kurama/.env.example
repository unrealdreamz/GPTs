# Kurama mindscape server configuration.
# Copy to .env (loaded automatically by server/server.mjs; real environment
# variables take precedence) and uncomment what you need. Empty values are ignored.

# --- HTTP -------------------------------------------------------------------
# Port and bind address. Defaults: 8787 on 127.0.0.1 (local only).
# Use HOST=0.0.0.0 to expose it on your network (it spends your API credits!).
#PORT=8787
#HOST=127.0.0.1

# --- Claude -----------------------------------------------------------------
# Credentials, resolved by the official @anthropic-ai/sdk (new Anthropic()).
# If neither is set the server starts in demo mode (canned offline replies).
#ANTHROPIC_API_KEY=sk-ant-...
#ANTHROPIC_AUTH_TOKEN=
# Optional API base URL override (proxies/gateways).
#ANTHROPIC_BASE_URL=https://api.anthropic.com

# Model id. Default: claude-opus-5
#CLAUDE_MODEL=claude-opus-5

# With no key/token in env, try one live request anyway on the first chat
# (e.g. credentials from an `ant auth login` profile). Stays in demo mode if it fails.
#KURAMA_TRY_LIVE=1

# Force demo mode even when credentials are present (no API spend).
#KURAMA_DEMO=1

# Server-side refusal fallbacks (sent only for claude-opus-5* / claude-fable-5* models). 0 = off.
#KURAMA_FALLBACKS=1

# --- VOICEVOX ---------------------------------------------------------------
# Engine URL. Default: http://127.0.0.1:50021
#VOICEVOX_URL=http://127.0.0.1:50021
# Speaker to use, matched by name from GET /speakers. Default: 青山龍星
# (falls back to the first available speaker if missing).
#VOICEVOX_SPEAKER=青山龍星
# Force one style id for every line (skips the emotion → style mapping).
#VOICEVOX_STYLE_ID=13
